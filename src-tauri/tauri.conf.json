{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "简记",
  "version": "0.1.0",
  "identifier": "com.ledon.jianji",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "简记",
        "width": 1120,
        "height": 740,
        "minWidth": 780,
        "minHeight": 520,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "本地优先的笔记与记账，数据都在 Markdown 里",
    "longDescription": "简记：笔记、待办、记账、图片都存在本地 Markdown 文件里，无需账号，断网可用。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
